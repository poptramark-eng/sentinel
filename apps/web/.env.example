# Public Supabase project settings. Use the publishable key, never a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Keep false in production until all child-data privacy/legal release gates are approved.
# The database also requires app.child_data_processing_enabled=true; that setting is not exposed to app users.
CHILD_DATA_PROCESSING_ENABLED=false
