    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@cbe/database": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@node-rs/argon2": "2.2.2",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "12.0.3",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3"
