# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cbe_platform?schema=public
WEB_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
API_PORT=4000
# Keep false unless behind a known proxy; then set an explicit trusted IP/CIDR list (never true/*).
TRUST_PROXY=false
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_PEPPER=replace-with-a-different-at-least-32-random-bytes
# Required in production for distributed auth rate limiting (login, refresh, registration and verification); local development may omit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set DEV_EMAIL_PREVIEW=true only for local verification-link testing; never enabled in production.
DEV_EMAIL_PREVIEW=true
RESEND_API_KEY=
EMAIL_FROM=
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_BASE_URL=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
WEB3_RPC_URL=
USDC_CHAIN_ID=
USDC_TOKEN_ADDRESS=
USDC_RECEIVING_ADDRESS=
BOOTSTRAP_ADMIN_GIVEN_NAME=
BOOTSTRAP_ADMIN_FAMILY_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
