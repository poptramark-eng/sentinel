generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformOperatorRole {
  PLATFORM_ADMINISTRATOR
}

enum PlatformOperatorStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  DISABLED
}

enum LoginIdentifierType {
  EMAIL
  PHONE
  USERNAME
}

enum CouncilStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CouncilMembershipRole {
  COUNCIL_ADMINISTRATOR
  COUNCIL_APPROVER
  COUNCIL_GOVERNANCE_APPROVER
  COUNCIL_MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum SchoolStatus {
  PROVISIONAL
  ACTIVE
  INACTIVE
}

enum RegistrationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  WITHDRAWN
  EXPIRED
}

enum SchoolMembershipRole {
  SCHOOL_ADMINISTRATOR
  TEACHER
}

enum SchoolIdentifierType {
  MINISTRY_REGISTRY
  COUNCIL_REGISTRY
  OTHER
}

enum GeographyStatus {
  ACTIVE
  INACTIVE
}

enum SchoolGrade {
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
  GRADE_6
  GRADE_7
  GRADE_8
  GRADE_9
}

enum SchoolClassStatus {
  ACTIVE
  ARCHIVED
}

enum StaffAssignmentType {
  CLASS_TEACHER
}

enum StaffAssignmentStatus {
  ACTIVE
  ENDED
  REVOKED
}

enum CurriculumVersionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED
}

enum CurriculumOptionality {
  UNKNOWN
  CORE
  OPTIONAL
}

enum CurriculumReviewStatus {
  REVIEW_REQUIRED
  REVIEWED
}

enum CouncilCurriculumStatus {
  ACTIVE
  SUPERSEDED
}

enum RubricScaleType {
  NUMERIC_BANDS
  PERFORMANCE_LEVELS
  DESCRIPTIVE
}

enum RubricVersionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED
}

enum AssessmentType {
  FORMATIVE
  SUMMATIVE
  PRACTICE
  OTHER
}

enum AssessmentStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  RELEASED
  CANCELLED
}

enum LearnerEnrollmentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  COMPLETED
}

enum AssessmentCandidateStatus {
  ACTIVE
  WITHDRAWN
}

enum AssessmentMarkStatus {
  DRAFT
  SUBMITTED
  RETURNED
}

enum AssessmentMarkRevisionAction {
  CREATED
  UPDATED
  SUBMITTED
  RETURNED
}

model Person {
  id          String   @id @default(uuid()) @db.Uuid
  givenName   String
  familyName  String
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account                UserAccount?
  councilMemberships     CouncilMembership[]
  schoolMemberships      SchoolMembership[]
  initiatedRegistrations CouncilSchoolRegistration[] @relation("RegistrationInitialRegistrant")

  @@index([familyName, givenName])
}

model UserAccount {
  id           String        @id @default(uuid()) @db.Uuid
  personId     String        @unique @db.Uuid
  status       AccountStatus @default(PENDING_VERIFICATION)
  authVersion  Int           @default(0)
  passwordHash String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?

  person                  Person                      @relation(fields: [personId], references: [id], onDelete: Restrict)
  platformOperator        PlatformOperator?
  refreshTokens           RefreshToken[]
  loginIdentifiers        LoginIdentifier[]
  emailVerificationTokens EmailVerificationToken[]
  reviewedRegistrations   CouncilSchoolRegistration[] @relation("RegistrationReviewer")
  createdCurriculumVersions  CurriculumVersion[] @relation("CurriculumVersionAuthor")
  reviewedCurriculumVersions CurriculumVersion[] @relation("CurriculumVersionReviewer")
  createdRubricVersions   GradingRubricVersion[] @relation("GradingRubricVersionAuthor")
  reviewedRubricVersions  GradingRubricVersion[] @relation("GradingRubricVersionReviewer")
  createdAssessments      Assessment[] @relation("AssessmentAuthor")
  enteredAssessmentMarks  AssessmentMark[] @relation("AssessmentMarkEnteredBy")
  assessmentMarkRevisions AssessmentMarkRevision[]
  auditEvents             AuditEvent[]

  @@index([status])
}

model PlatformOperator {
  id        String                 @id @default(uuid()) @db.Uuid
  accountId String                 @unique @db.Uuid
  role      PlatformOperatorRole   @default(PLATFORM_ADMINISTRATOR)
  status    PlatformOperatorStatus @default(ACTIVE)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  account UserAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([status, role])
}

model LoginIdentifier {
  id              String              @id @default(uuid()) @db.Uuid
  accountId       String              @db.Uuid
  type            LoginIdentifierType
  normalizedValue String
  verifiedAt      DateTime?
  createdAt       DateTime            @default(now())

  account                 UserAccount              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  emailVerificationTokens EmailVerificationToken[]

  @@unique([id, accountId])
  @@unique([type, normalizedValue])
  @@index([accountId, verifiedAt])
}

// The migration also adds a partial unique index for one unconsumed token per identifier.
model EmailVerificationToken {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @db.Uuid
  loginIdentifierId String    @db.Uuid
  tokenHash         String    @unique
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())

  account         UserAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  loginIdentifier LoginIdentifier @relation(fields: [loginIdentifierId, accountId], references: [id, accountId], onDelete: Restrict)

  @@index([accountId, expiresAt])
  @@index([loginIdentifierId, consumedAt])
  @@index([expiresAt])
}

model Council {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  slug      String        @unique
  status    CouncilStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships          CouncilMembership[]
  registrations        CouncilSchoolRegistration[]
  regions               Region[]
  curriculumSelections CouncilCurriculum[]
  gradingRubrics        GradingRubric[]
  assessments           Assessment[]
  auditEvents           AuditEvent[]

  @@index([status, name])
}

model CouncilMembership {
  id        String                @id @default(uuid()) @db.Uuid
  councilId String                @db.Uuid
  personId  String                @db.Uuid
  role      CouncilMembershipRole
  status    MembershipStatus      @default(PENDING)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  council Council @relation(fields: [councilId], references: [id], onDelete: Restrict)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([councilId, personId, role])
  @@index([personId, status])
  @@index([councilId, status, role])
}

model School {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  status    SchoolStatus @default(PROVISIONAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  identifiers   SchoolIdentifier[]
  registrations CouncilSchoolRegistration[]

  @@index([name])
}

model SchoolIdentifier {
  id              String               @id @default(uuid()) @db.Uuid
  schoolId        String               @db.Uuid
  type            SchoolIdentifierType
  issuer          String
  normalizedValue String
  verifiedAt      DateTime?
  createdAt       DateTime             @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([issuer, normalizedValue])
  @@index([schoolId, type])
}

model Region {
  id        String          @id @default(uuid()) @db.Uuid
  councilId String          @db.Uuid
  name      String
  code      String?
  status    GeographyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())

  council  Council  @relation(fields: [councilId], references: [id], onDelete: Restrict)
  counties County[]

  @@unique([id, councilId])
  @@unique([councilId, name])
  @@index([councilId, status])
}

model County {
  id        String          @id @default(uuid()) @db.Uuid
  councilId String          @db.Uuid
  regionId  String          @db.Uuid
  name      String
  code      String?
  status    GeographyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())

  region      Region      @relation(fields: [regionId, councilId], references: [id, councilId], onDelete: Restrict)
  subcounties Subcounty[]

  @@unique([id, councilId])
  @@unique([regionId, name])
  @@index([councilId, status])
}

model Subcounty {
  id        String          @id @default(uuid()) @db.Uuid
  councilId String          @db.Uuid
  countyId  String          @db.Uuid
  name      String
  code      String?
  status    GeographyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())

  county County @relation(fields: [countyId, councilId], references: [id, councilId], onDelete: Restrict)
  zones  Zone[]

  @@unique([id, councilId])
  @@unique([countyId, name])
  @@index([councilId, status])
}

model Zone {
  id          String          @id @default(uuid()) @db.Uuid
  councilId   String          @db.Uuid
  subcountyId String          @db.Uuid
  name        String
  code        String?
  status      GeographyStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())

  subcounty Subcounty @relation(fields: [subcountyId, councilId], references: [id, councilId], onDelete: Restrict)
  clusters  Cluster[]

  @@unique([id, councilId])
  @@unique([subcountyId, name])
  @@index([councilId, status])
}

model Cluster {
  id        String          @id @default(uuid()) @db.Uuid
  councilId String          @db.Uuid
  zoneId    String          @db.Uuid
  name      String
  code      String?
  status    GeographyStatus @default(ACTIVE)
  createdAt DateTime        @default(now())

  zone          Zone                        @relation(fields: [zoneId, councilId], references: [id, councilId], onDelete: Restrict)
  registrations CouncilSchoolRegistration[]

  @@unique([id, councilId])
  @@unique([zoneId, name])
  @@index([councilId, status])
}

model CouncilSchoolRegistration {
  id                        String             @id @default(uuid()) @db.Uuid
  councilId                 String             @db.Uuid
  schoolId                  String             @db.Uuid
  clusterId                 String             @db.Uuid
  registrationCode          String?
  submittedSchoolName       String
  status                    RegistrationStatus @default(PENDING_REVIEW)
  initialRegistrantPersonId String             @db.Uuid
  reviewedByAccountId       String?            @db.Uuid
  submittedAt               DateTime           @default(now())
  reviewedAt                DateTime?
  decisionReason            String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  version                   Int                @default(0)

  council           Council            @relation(fields: [councilId], references: [id], onDelete: Restrict)
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  cluster           Cluster            @relation(fields: [clusterId, councilId], references: [id, councilId], onDelete: Restrict)
  initialRegistrant Person             @relation("RegistrationInitialRegistrant", fields: [initialRegistrantPersonId], references: [id], onDelete: Restrict)
  reviewedBy        UserAccount?       @relation("RegistrationReviewer", fields: [reviewedByAccountId], references: [id], onDelete: Restrict)
  memberships       SchoolMembership[]
  schoolClasses     SchoolClass[]
  learnerEnrollments SchoolLearnerEnrollment[]
  assessmentCandidates AssessmentCandidate[]

  @@unique([id, councilId])
  @@unique([councilId, registrationCode])
  @@index([councilId, status, submittedAt])
  @@index([schoolId, councilId, createdAt])
}

model SchoolMembership {
  id             String               @id @default(uuid()) @db.Uuid
  registrationId String               @db.Uuid
  councilId      String               @db.Uuid
  personId       String               @db.Uuid
  role           SchoolMembershipRole
  status         MembershipStatus     @default(PENDING)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  registration    CouncilSchoolRegistration @relation(fields: [registrationId, councilId], references: [id, councilId], onDelete: Restrict)
  person          Person                    @relation(fields: [personId], references: [id], onDelete: Restrict)
  staffAssignments StaffAssignment[]

  @@unique([id, registrationId, councilId])
  @@unique([registrationId, personId, role])
  @@index([personId, status])
  @@index([registrationId, status, role])
}


model SchoolClass {
  id             String            @id @default(uuid()) @db.Uuid
  registrationId String            @db.Uuid
  councilId      String            @db.Uuid
  grade          SchoolGrade
  academicYear   Int
  streamCode     String            @default("MAIN")
  displayName    String?
  status         SchoolClassStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  registration CouncilSchoolRegistration @relation(fields: [registrationId, councilId], references: [id, councilId], onDelete: Restrict)
  assignments  StaffAssignment[]
  learnerEnrollments SchoolLearnerEnrollment[]
  assessmentCandidates AssessmentCandidate[]

  @@unique([id, registrationId, councilId])
  @@unique([registrationId, academicYear, grade, streamCode])
  @@index([councilId, academicYear, grade, status])
  @@index([registrationId, status, grade])
}

model StaffAssignment {
  id             String                @id @default(uuid()) @db.Uuid
  registrationId String                @db.Uuid
  councilId      String                @db.Uuid
  schoolClassId  String                @db.Uuid
  membershipId   String                @db.Uuid
  type           StaffAssignmentType   @default(CLASS_TEACHER)
  status         StaffAssignmentStatus @default(ACTIVE)
  startsAt       DateTime              @default(now())
  endsAt         DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  schoolClass SchoolClass     @relation(fields: [schoolClassId, registrationId, councilId], references: [id, registrationId, councilId], onDelete: Restrict)
  membership  SchoolMembership @relation(fields: [membershipId, registrationId, councilId], references: [id, registrationId, councilId], onDelete: Restrict)

  @@unique([id, registrationId, councilId])
  @@index([registrationId, status, type])
  @@index([membershipId, status, startsAt])
  @@index([schoolClassId, status, type])
}

model Learner {
  id            String   @id @default(uuid()) @db.Uuid
  learnerNumber String   @unique
  givenName     String
  familyName    String
  otherNames    String?
  displayName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments SchoolLearnerEnrollment[]
  assessmentCandidates AssessmentCandidate[]

  @@index([familyName, givenName])
}

model SchoolLearnerEnrollment {
  id             String                 @id @default(uuid()) @db.Uuid
  learnerId      String                 @db.Uuid
  registrationId String                 @db.Uuid
  councilId      String                 @db.Uuid
  schoolClassId  String                 @db.Uuid
  admissionNumber String?
  status         LearnerEnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime               @default(now())
  endedAt        DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  learner      Learner                  @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  registration CouncilSchoolRegistration @relation(fields: [registrationId, councilId], references: [id, councilId], onDelete: Restrict)
  schoolClass  SchoolClass              @relation(fields: [schoolClassId, registrationId, councilId], references: [id, registrationId, councilId], onDelete: Restrict)
  assessmentCandidates AssessmentCandidate[]

  @@unique([id, learnerId, registrationId, councilId])
  @@index([registrationId, schoolClassId, status])
  @@index([learnerId, status, enrolledAt])
}

model AssessmentCandidate {
  id                       String                    @id @default(uuid()) @db.Uuid
  assessmentId             String                    @db.Uuid
  councilId                String                    @db.Uuid
  curriculumVersionId      String                    @db.Uuid
  learnerId                String                    @db.Uuid
  enrollmentId             String                    @db.Uuid
  registrationId           String                    @db.Uuid
  schoolClassId            String                    @db.Uuid
  learnerNumberSnapshot    String
  learnerNameSnapshot      String
  classGradeSnapshot       SchoolGrade
  classStreamSnapshot      String
  status                   AssessmentCandidateStatus @default(ACTIVE)
  createdAt                DateTime                  @default(now())

  assessment   Assessment             @relation(fields: [assessmentId, councilId, curriculumVersionId], references: [id, councilId, curriculumVersionId], onDelete: Restrict)
  learner      Learner                @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  enrollment   SchoolLearnerEnrollment @relation(fields: [enrollmentId, learnerId, registrationId, councilId], references: [id, learnerId, registrationId, councilId], onDelete: Restrict)
  registration CouncilSchoolRegistration @relation(fields: [registrationId, councilId], references: [id, councilId], onDelete: Restrict)
  schoolClass  SchoolClass            @relation(fields: [schoolClassId, registrationId, councilId], references: [id, registrationId, councilId], onDelete: Restrict)
  marks        AssessmentMark[]

  @@unique([id, assessmentId])
  @@unique([assessmentId, learnerId])
  @@index([assessmentId, status, learnerNameSnapshot])
  @@index([registrationId, schoolClassId, status])
}

model AssessmentMark {
  id                       String              @id @default(uuid()) @db.Uuid
  assessmentId             String              @db.Uuid
  candidateId              String              @db.Uuid
  assessmentLearningAreaId String              @db.Uuid
  marks                    Decimal?            @db.Decimal(8, 2)
  status                   AssessmentMarkStatus @default(DRAFT)
  enteredByAccountId       String?             @db.Uuid
  submittedAt              DateTime?
  returnedReason           String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  candidate          AssessmentCandidate   @relation(fields: [candidateId, assessmentId], references: [id, assessmentId], onDelete: Restrict)
  assessmentLearningArea AssessmentLearningArea @relation(fields: [assessmentLearningAreaId, assessmentId], references: [id, assessmentId], onDelete: Restrict)
  enteredBy          UserAccount?          @relation("AssessmentMarkEnteredBy", fields: [enteredByAccountId], references: [id], onDelete: Restrict)
  revisions          AssessmentMarkRevision[]

  @@unique([candidateId, assessmentLearningAreaId])
  @@index([assessmentId, status])
  @@index([enteredByAccountId, updatedAt])
}

model AssessmentMarkRevision {
  id             String                     @id @default(uuid()) @db.Uuid
  markId         String                     @db.Uuid
  actorAccountId String                     @db.Uuid
  action         AssessmentMarkRevisionAction
  previousMarks  Decimal?                   @db.Decimal(8, 2)
  newMarks       Decimal?                   @db.Decimal(8, 2)
  reason         String?
  createdAt      DateTime                   @default(now())

  mark  AssessmentMark @relation(fields: [markId], references: [id], onDelete: Restrict)
  actor UserAccount    @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([markId, createdAt])
  @@index([actorAccountId, createdAt])
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorAccountId String?  @db.Uuid
  councilId      String?  @db.Uuid
  action         String
  resourceType   String
  resourceId     String
  decision       String?
  reason         String?
  correlationId  String?
  metadata       Json?
  createdAt      DateTime @default(now())

  actor   UserAccount? @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)
  council Council?     @relation(fields: [councilId], references: [id], onDelete: Restrict)

  @@index([councilId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([actorAccountId, createdAt])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  account UserAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}


model Curriculum {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  track     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions CurriculumVersion[]

  @@index([track, name])
}

model CurriculumVersion {
  id                 String                  @id @default(uuid()) @db.Uuid
  curriculumId       String                  @db.Uuid
  versionLabel       String
  status             CurriculumVersionStatus @default(DRAFT)
  sourceTitle        String
  sourceUrl          String
  sourceRetrievedAt  DateTime
  sourceSha256       String                  @db.VarChar(64)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  createdByAccountId String                  @db.Uuid
  reviewedByAccountId String?                @db.Uuid
  publishedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  curriculum Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  author     UserAccount  @relation("CurriculumVersionAuthor", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  reviewer   UserAccount? @relation("CurriculumVersionReviewer", fields: [reviewedByAccountId], references: [id], onDelete: Restrict)
  gradeLearningAreas GradeLearningArea[]
  councilCurricula   CouncilCurriculum[]

  @@unique([curriculumId, versionLabel])
  @@unique([id, curriculumId])
  @@index([status, createdAt])
  @@index([curriculumId, status])
}

model LearningArea {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  canonicalName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gradeLearningAreas GradeLearningArea[]

  @@index([canonicalName])
}

model GradeLearningArea {
  id                 String                 @id @default(uuid()) @db.Uuid
  curriculumVersionId String                @db.Uuid
  learningAreaId     String                 @db.Uuid
  grade              SchoolGrade
  sourceLabel        String
  sourceUrl          String
  sortOrder          Int                    @default(0)
  optionality        CurriculumOptionality  @default(UNKNOWN)
  reviewStatus       CurriculumReviewStatus @default(REVIEW_REQUIRED)
  reviewNote         String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  learningArea      LearningArea      @relation(fields: [learningAreaId], references: [id], onDelete: Restrict)
  councilConfigurations CouncilGradeLearningArea[]

  @@unique([curriculumVersionId, grade, learningAreaId])
  @@unique([id, curriculumVersionId])
  @@index([curriculumVersionId, grade, sortOrder])
  @@index([learningAreaId, grade])
  @@index([reviewStatus, optionality])
}

model CouncilCurriculum {
  id                 String                  @id @default(uuid()) @db.Uuid
  councilId          String                  @db.Uuid
  curriculumVersionId String                 @db.Uuid
  status             CouncilCurriculumStatus @default(ACTIVE)
  effectiveFrom      DateTime                @default(now())
  effectiveTo        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  council           Council           @relation(fields: [councilId], references: [id], onDelete: Restrict)
  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  gradeAreas        CouncilGradeLearningArea[]
  assessments       Assessment[]

  @@unique([id, councilId, curriculumVersionId])
  @@unique([councilId, curriculumVersionId, effectiveFrom])
  @@index([councilId, status, effectiveFrom])
  @@index([curriculumVersionId, status])
}

model CouncilGradeLearningArea {
  id                  String   @id @default(uuid()) @db.Uuid
  councilCurriculumId String   @db.Uuid
  councilId           String   @db.Uuid
  curriculumVersionId String   @db.Uuid
  gradeLearningAreaId String   @db.Uuid
  enabled             Boolean  @default(true)
  assessmentEligible  Boolean  @default(false)
  displayLabel        String?
  sortOrder           Int      @default(0)
  reviewNote          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  councilCurriculum CouncilCurriculum @relation(fields: [councilCurriculumId, councilId, curriculumVersionId], references: [id, councilId, curriculumVersionId], onDelete: Restrict)
  gradeLearningArea GradeLearningArea @relation(fields: [gradeLearningAreaId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict)
  assessmentItems   AssessmentLearningArea[]

  @@unique([councilCurriculumId, gradeLearningAreaId])
  @@unique([id, councilId, curriculumVersionId])
  @@index([councilId, enabled, assessmentEligible])
  @@index([councilCurriculumId, sortOrder])
}

model GradingRubric {
  id          String   @id @default(uuid()) @db.Uuid
  councilId   String   @db.Uuid
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  council  Council                @relation(fields: [councilId], references: [id], onDelete: Restrict)
  versions GradingRubricVersion[]

  @@unique([id, councilId])
  @@unique([councilId, code])
  @@index([councilId, name])
}

model GradingRubricVersion {
  id                String             @id @default(uuid()) @db.Uuid
  rubricId          String             @db.Uuid
  councilId         String             @db.Uuid
  versionLabel      String
  status            RubricVersionStatus @default(DRAFT)
  scaleType         RubricScaleType
  scoreUnit         String?
  minScore          Decimal?           @db.Decimal(10, 4)
  maxScore          Decimal?           @db.Decimal(10, 4)
  createdByAccountId String            @db.Uuid
  reviewedByAccountId String?          @db.Uuid
  publishedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  rubric     GradingRubric @relation(fields: [rubricId, councilId], references: [id, councilId], onDelete: Restrict)
  author     UserAccount   @relation("GradingRubricVersionAuthor", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  reviewer   UserAccount?  @relation("GradingRubricVersionReviewer", fields: [reviewedByAccountId], references: [id], onDelete: Restrict)
  bands      RubricBand[]
  assessments Assessment[]

  @@unique([id, councilId])
  @@unique([id, rubricId])
  @@unique([rubricId, versionLabel])
  @@index([councilId, status, createdAt])
  @@index([rubricId, status])
}

model RubricBand {
  id               String   @id @default(uuid()) @db.Uuid
  rubricVersionId  String   @db.Uuid
  code             String
  label            String
  description      String?
  lowerBound       Decimal? @db.Decimal(10, 4)
  upperBound       Decimal? @db.Decimal(10, 4)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rubricVersion GradingRubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)
  assessmentSnapshots AssessmentRubricBand[]

  @@unique([id, rubricVersionId])
  @@unique([rubricVersionId, code])
  @@unique([rubricVersionId, sortOrder])
  @@index([rubricVersionId, lowerBound, upperBound])
}

model Assessment {
  id                    String          @id @default(uuid()) @db.Uuid
  councilId             String          @db.Uuid
  councilCurriculumId   String          @db.Uuid
  curriculumVersionId   String          @db.Uuid
  rubricVersionId       String          @db.Uuid
  name                  String
  code                  String
  academicYear          Int
  grade                 SchoolGrade
  type                  AssessmentType
  status                AssessmentStatus @default(DRAFT)
  opensAt               DateTime?
  closesAt              DateTime?
  createdByAccountId    String          @db.Uuid
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  council           Council                @relation(fields: [councilId], references: [id], onDelete: Restrict)
  councilCurriculum CouncilCurriculum      @relation(fields: [councilCurriculumId, councilId, curriculumVersionId], references: [id, councilId, curriculumVersionId], onDelete: Restrict)
  rubricVersion     GradingRubricVersion   @relation(fields: [rubricVersionId, councilId], references: [id, councilId], onDelete: Restrict)
  author            UserAccount            @relation("AssessmentAuthor", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  learningAreas     AssessmentLearningArea[]
  rubricBands       AssessmentRubricBand[]
  candidates        AssessmentCandidate[]
  marks             AssessmentMark[]

  @@unique([id, councilId, curriculumVersionId])
  @@unique([id, rubricVersionId])
  @@unique([councilId, code, academicYear])
  @@index([councilId, academicYear, grade, status])
  @@index([councilCurriculumId, status])
  @@index([rubricVersionId])
}

model AssessmentLearningArea {
  id                       String   @id @default(uuid()) @db.Uuid
  assessmentId             String   @db.Uuid
  councilId                String   @db.Uuid
  curriculumVersionId      String   @db.Uuid
  councilGradeLearningAreaId String @db.Uuid
  grade                    SchoolGrade
  learningAreaCode         String
  canonicalName            String
  sourceLabel              String
  displayLabel             String?
  maxMarks                 Decimal  @db.Decimal(8, 2)
  decimalPlaces            Int      @default(0)
  sortOrder                Int      @default(0)
  createdAt                DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId, councilId, curriculumVersionId], references: [id, councilId, curriculumVersionId], onDelete: Restrict)
  councilGradeLearningArea CouncilGradeLearningArea @relation(fields: [councilGradeLearningAreaId, councilId, curriculumVersionId], references: [id, councilId, curriculumVersionId], onDelete: Restrict)
  marks AssessmentMark[]

  @@unique([id, assessmentId])
  @@unique([assessmentId, councilGradeLearningAreaId])
  @@index([assessmentId, sortOrder])
  @@index([councilGradeLearningAreaId])
}

model AssessmentRubricBand {
  id               String   @id @default(uuid()) @db.Uuid
  assessmentId     String   @db.Uuid
  rubricVersionId  String   @db.Uuid
  sourceRubricBandId String @db.Uuid
  code             String
  label            String
  description      String?
  lowerBound       Decimal? @db.Decimal(10, 4)
  upperBound       Decimal? @db.Decimal(10, 4)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId, rubricVersionId], references: [id, rubricVersionId], onDelete: Restrict)
  sourceBand  RubricBand @relation(fields: [sourceRubricBandId, rubricVersionId], references: [id, rubricVersionId], onDelete: Restrict)

  @@unique([assessmentId, sourceRubricBandId])
  @@index([assessmentId, sortOrder])
}

